# Botón
Thel                             = %s
ReOpenDoli                       = Reabrir
Sign                             = Firmar
Lock                             = Bloquear
Archive                          = Archivar
Clone                            = Clonar
ObjectMustBeDraft                = %s debe estar en estado (borrador)
ObjectMustBeValidated            = %s debe estar en estado (validado)
ObjectMustBeLocked               = %s debe estar en estado (bloqueado)
ObjectMustBeValidatedToGenerate  = %s debe estar en estado (validado) para generar el documento
ObjectMustBeLockedToGenerate     = %s debe estar en estado (bloqueado) para generar el documento
ObjectMustBeValidatedToSign      = %s debe estar en estado (validado) para que los participantes puedan firmar
AllSignatoriesMustHaveSigned     = Todos los participantes deben haber firmado para bloquear %s
